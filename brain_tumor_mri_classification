(eda_df)\n","    *\n","    100\n",")\n","\n","aspect_category_df.to_csv(\n","    AUDIT_RESULTS_DIR /\n","    \"bdneuro_aspect_ratio_categories.csv\",\n","    index=False\n",")\n","\n","\n","# ------------------------------------------------------------\n","# IMAGE INTENSITY STATISTICS\n","# ------------------------------------------------------------\n","\n","intensity_records = []\n","\n","for row in tqdm(\n","    eda_df.itertuples(\n","        index=False\n","    ),\n","    total=len(eda_df),\n","    desc=\"Analyzing image intensity\"\n","):\n","\n","    with Image.open(\n","        row.absolute_path\n","    ) as image:\n","\n","        image = image.convert(\"L\")\n","\n","        array = np.asarray(\n","            image,\n","            dtype=np.float32\n","        ) / 255.0\n","\n","    intensity_records.append(\n","        {\n","            \"relative_path\":\n","                row.relative_path,\n","\n","            \"split\":\n","                row.split,\n","\n","            \"class\":\n","                row._2\n","                if hasattr(row, \"_2\")\n","                else getattr(\n","                    row,\n","                    \"class\"\n","                ),\n","\n","            \"mean_intensity\":\n","                float(\n","                    array.mean()\n","                ),\n","\n","            \"std_intensity\":\n","                float(\n","                    array.std()\n","                ),\n","\n","            \"minimum_intensity\":\n","                float(\n","                    array.min()\n","                ),\n","\n","            \"maximum_intensity\":\n","                float(\n","                    array.max()\n","                ),\n","\n","            \"p01\":\n","                float(\n","                    np.percentile(\n","                        array,\n","                        1\n","                    )\n","                ),\n","\n","            \"p50\":\n","                float(\n","           